{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trader-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trader",
      "database_id": "<your-d1-database-id>",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "linda-memory",
      "remote": true
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "triggers": {
    // Every 5 minutes (UTC). Cheap rule-based watcher; LLM only wakes on a trigger.
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "APP_TIMEZONE": "Asia/Jakarta",
    "LOGS_INGEST_URL": "",

    // ── Trading config ─────────────────────────────────────────────────────────
    "TRADING_SYMBOL": "BTCUSDC",
    "BASE_COIN": "BTC",
    "QUOTE_COIN": "USDC",
    "BYBIT_BASE_URL": "https://api-demo.bybit.com",
    "EXECUTE_TRADES": "true", // "false" = paper mode (decide + record, no order)
    "MIN_CONFIDENCE": "65",
    "RISK_PCT": "1",
    "MAX_POSITION_PCT": "20",
    "SELF_CONSISTENCY": "1", // 3 = majority-vote 3 LLM samples for steadier calls

    // ── Groq (each key MUST be a separate org to multiply daily limits) ────────
    "GROQ_CHAT_MODEL": "openai/gpt-oss-120b",
    "GROQ_UTILITY_MODEL": "llama-3.1-8b-instant",
    "GROQ_API_KEY_1": "<groq-key-org-1>",
    "GROQ_API_KEY_2": "<groq-key-org-2>",
    "GROQ_API_KEY_3": "<groq-key-org-3>",

    // ── Bybit demo keys ────────────────────────────────────────────────────────
    "BYBIT_API_KEY": "<bybit-demo-key>",
    "BYBIT_API_SECRET": "<bybit-demo-secret>",

    // Optional: guards POST /run and /evaluate (sent as x-admin-secret header).
    "ADMIN_SECRET": "",

    // Optional: Upstash Redis keeps live key rate-limit state across cron runs.
    "UPSTASH_REDIS_REST_URL": "",
    "UPSTASH_REDIS_REST_TOKEN": ""
  }
}
